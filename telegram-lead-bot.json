    {
      "parameters": {
        "jsCode": "const msg = $('Telegram Trigger').first().json.message;\n\nconst row = $input.first()?.json || {};\n\nconst known = {\n  name: row.name || '',\n  need: row.need || '',\n  quantity: row.quantity || '',\n  city: row.city || ''\n};\n\nconst prompt = `\nYou are a professional enquiry assistant for PPS Anantams Corporation.\n\nBUSINESSES:\n\n1. Bitumen supply:\nVG-10, VG-30, VG-40, emulsion, CRMB and PMB.\n\n2. YUGA PMC:\nPlant consulting for pyrolysis, bio-bitumen,\nbitumen emulsion and related industrial plants.\n\n3. PACPL:\nTradingView indicators, Pine Script and\nalgorithmic trading software.\nNever provide trading tips or financial advice.\n\nCUSTOMER INFORMATION:\n${JSON.stringify(known)}\n\nCUSTOMER MESSAGE:\n${msg.text || ''}\n\nYOUR TASK:\n\n1. Understand the customer's requirement.\n2. Extract their name, need, quantity and city.\n3. Preserve previously collected information.\n4. Ask for only ONE missing detail at a time.\n5. Reply in the customer's language:\nEnglish, Hindi or Gujarati.\n6. Never invent prices, stock availability or delivery dates.\n7. Say the company team will provide quotations.\n\nIf quantity is irrelevant to the enquiry,\nuse \"Not applicable\".\n\nReturn ONLY valid JSON:\n\n{\n  \"reply\": \"\",\n  \"name\": \"\",\n  \"need\": \"\",\n  \"quantity\": \"\",\n  \"city\": \"\",\n  \"interested\": false\n}\n`;\n\nreturn [{\n  json: {\n    chat_id: String(msg.chat.id),\n    username: msg.from?.username || '',\n    text: msg.text || '',\n    known,\n    created_at: row.created_at || new Date().toISOString(),\n    prompt\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        -80
      ],
      "id": "3e7fc190-ea53-405b-86f0-000ba26c4498",
      "name": "Build Context"
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Build Context').first().json;\n\nconst response = $json.candidates?.[0]?.content?.parts\n  ?.map(p => p.text || '')\n  .join('') || '';\n\nlet d;\n\ntry {\n  const clean = response\n    .replace(/```json/gi, '')\n    .replace(/```/g, '')\n    .trim();\n\n  d = JSON.parse(clean);\n\n} catch (error) {\n\n  d = {\n    reply: \"Thank you for contacting PPS Anantams. Our team will get back to you shortly.\",\n    interested: false\n  };\n\n}\n\nconst m = {\n  name: d.name || ctx.known.name,\n  need: d.need || ctx.known.need,\n  quantity: d.quantity || ctx.known.quantity,\n  city: d.city || ctx.known.city\n};\n\nconst complete =\n  Boolean(m.name && m.need && m.quantity && m.city);\n\nreturn [{\n  json: {\n    chat_id: ctx.chat_id,\n    channel: 'telegram',\n    username: ctx.username,\n\n    ...m,\n\n    status: complete\n      ? 'Qualified'\n      : (d.interested ? 'Interested' : 'New'),\n\n    last_message: ctx.text,\n\n    last_contact_at: new Date().toISOString(),\n\n    followup_sent: '',\n\n    created_at: ctx.created_at,\n\n    reply: d.reply ||\n      \"Thank you! Our team will contact you shortly.\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
