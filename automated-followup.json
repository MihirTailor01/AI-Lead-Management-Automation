    {
      "parameters": {
        "jsCode": "const cutoff = Date.now() - 24 * 60 * 60 * 1000;\n\nreturn $input.all().filter(item => {\n  const lead = item.json;\n\n  return (\n    ['New', 'Interested', 'Qualified'].includes(lead.status?.trim()) &&\n    lead.followup_sent?.trim().toLowerCase() !== 'yes' &&\n    new Date(lead.last_contact_at).getTime() < cutoff\n  );\n});"
      },
